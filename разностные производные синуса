#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double f(double x) { 
    return sin(x); } //исходная функция

double df_exact(double x) { 
    return cos(x); } //точное значение производной

int main() {
    setlocale(LC_ALL, "Russian");

    const int n = 7; //количество узлов сетки на оси ОХ
    double h = 0.5; //шаг между узлами

    cout << "-----------------------------------------------------------------------------------------------" << endl;
    cout << " i |  x   | Левая пр. | Л. погр. | Правая пр. | Пр. погр | Центр. пр. | Ц. погр | Точное знач. |" << endl;
    cout << "-----------------------------------------------------------------------------------------------" << endl;

    for (int i = 0; i < n; i++) {
        double x = i * h; //вычисление координаты точки на сетке
        double exact = df_exact(x);  // Точное значение для всех сравнений

        cout << fixed << setprecision(2) << setw(2) << i << " | "
            << setw(4) << x << " | ";

        //левая производная и ее погрешность
        if (i > 0) {
            double d_left = (f(x) - f(x - h)) / h; //формула левой производной
            double error_left = abs(d_left - exact); //погрешность левой производной
            cout << setw(9) << d_left << " | "
                << setw(6) << error_left << " | ";
        }
        else {
            cout << "  -----   | ------ | "; //если выходит за границы
        }

        //правая производная и ее погрешность
        if (i < n - 1) {
            double d_right = (f(x + h) - f(x)) / h; //формула правой производной
            double error_right = abs(d_right - exact); //погрешность правой производной
            cout << setw(10) << d_right << " | "
                << setw(6) << error_right << " | ";
        }
        else {
            cout << "  ------  | ------ | "; //если выходит за границы
        }

        //центральная производная и её погрешность
        if (i > 0 && i < n - 1) {
            double d_central = (f(x + h) - f(x - h)) / (2 * h); //формула центральной производной
            double error_central = abs(d_central - exact); //погрешность центральной производной
            cout << setw(10) << d_central << " | "
                << setw(6) << error_central << " | ";
        }
        else {
            cout << "  ------  | ------ | ";
        }

        //точное значение
        cout << setw(12) << exact << " |";

        cout << endl;
    }

    return 0;
}
